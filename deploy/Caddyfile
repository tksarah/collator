{
	email {$ACME_EMAIL}
	admin off
	http_port 8080
	https_port 8443
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@auth path /api/v1/auth/*
	handle @auth {
		reverse_proxy auth-broker:8081 {
			header_up X-Real-IP {remote_host}
		}
	}
	@restart {
		method POST
		path /api/v1/actions/restart
	}
	handle @restart {
		reverse_proxy auth-broker:8081 {
			header_up X-Real-IP {remote_host}
		}
	}
	@settings_update {
		method PUT
		path /api/v1/settings
	}
	handle @settings_update {
		reverse_proxy auth-broker:8081 {
			header_up X-Real-IP {remote_host}
		}
	}
	@public_status path /api/v1/public/status
	handle @public_status {
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}
