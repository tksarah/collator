FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build
WORKDIR /app
ARG NEXT_PUBLIC_SITE_URL=https://guardian.invalid
ARG NEXT_PUBLIC_DEMO_MODE=false
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_DEMO_MODE=${NEXT_PUBLIC_DEMO_MODE}
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY app ./app
COPY public ./public
COPY tests ./tests
COPY next.config.ts tsconfig.json eslint.config.mjs ./
RUN pnpm run lint && pnpm test

FROM caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --chown=65532:65532 --from=build /app/out /srv
RUN setcap -r /usr/bin/caddy && chown -R 65532:65532 /data /config
USER 65532:65532
